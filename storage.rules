rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email in [
        'marcosferreira@mobcontent.com.br',
        'mobcontent.mda@gmail.com'
      ];
    }

    function nfDoc(analysisId) {
      return firestore.get(/databases/(default)/documents/nf_analyses/$(analysisId));
    }

    function projectDoc(projectId) {
      return firestore.get(/databases/(default)/documents/production_projects/$(projectId));
    }

    function empresaDoc(empresaId) {
      return firestore.get(/databases/(default)/documents/empresas/$(empresaId));
    }

    function membroDoc(empresaId) {
      return firestore.get(/databases/(default)/documents/empresas/$(empresaId)/membros/$(request.auth.uid));
    }

    function isOwnerEmpresa(empresaId) {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/empresas/$(empresaId))
        && empresaDoc(empresaId).data.ownerUid == request.auth.uid;
    }

    function isMembroAtivo(empresaId) {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/empresas/$(empresaId)/membros/$(request.auth.uid))
        && membroDoc(empresaId).data.status == 'active';
    }

    function assignedProjects(empresaId) {
      return membroDoc(empresaId).data.get('assignedProjects', []);
    }

    function canAccessProject(empresaId, projectId) {
      return isAdmin()
        || isOwnerEmpresa(empresaId)
        || (isMembroAtivo(empresaId) && (
             membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro']
             || (membroDoc(empresaId).data.keys().hasAll(['assignedProjects'])
                 && projectId in membroDoc(empresaId).data.assignedProjects)
             || projectId in assignedProjects(empresaId)
           ));
    }

    function canAccessEmpresa(empresaId) {
      return isAdmin()
        || isOwnerEmpresa(empresaId)
        || (isMembroAtivo(empresaId)
            && membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro']);
    }

    function canAccessProjectById(projectId) {
      return firestore.exists(/databases/(default)/documents/production_projects/$(projectId))
        && projectDoc(projectId).data.keys().hasAll(['empresaId'])
        && projectDoc(projectId).data.empresaId is string
        && canAccessProject(projectDoc(projectId).data.empresaId, projectId);
    }

    function canAccessAnalysis(analysisId) {
      return firestore.exists(/databases/(default)/documents/nf_analyses/$(analysisId))
        && (
          isAdmin()
          || nfDoc(analysisId).data.userId == request.auth.uid
          || (nfDoc(analysisId).data.keys().hasAll(['projectId'])
              && nfDoc(analysisId).data.projectId is string
              && canAccessProjectById(nfDoc(analysisId).data.projectId))
          || (nfDoc(analysisId).data.keys().hasAll(['empresaId'])
              && nfDoc(analysisId).data.empresaId is string
              && canAccessEmpresa(nfDoc(analysisId).data.empresaId))
        );
    }

    function canWriteReceipt(analysisId) {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/nf_analyses/$(analysisId))
        && (
          isAdmin()
          || nfDoc(analysisId).data.userId == request.auth.uid
          || (
            nfDoc(analysisId).data.empresaId is string
            && firestore.exists(
                 /databases/(default)/documents/empresas/$(nfDoc(analysisId).data.empresaId)/membros/$(request.auth.uid)
               )
            && membroDoc(nfDoc(analysisId).data.empresaId).data.status == 'active'
          )
        );
    }

    function isValidProjectFile() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/vnd.*')
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    function isValidEditalUpload() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Oráculo — PDFs importados, capas thumbnail_*, etc.
    match /editais/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && isValidEditalUpload();
    }

    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /notas-fiscais/{userId}/{fileName} {
      allow read: if isAuth() && request.auth.uid == userId;

      allow write: if isAuth()
        && request.auth.uid == userId
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 200 * 1024;

      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /payment_receipts/{analysisId}/{allPaths=**} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuth();
    }

    match /omie_anexos/{projectId}/{analysisId}/{allPaths=**} {
      allow read: if canAccessProjectById(projectId) || canAccessAnalysis(analysisId);
      allow write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read: if canAccessProjectById(projectId);
      allow create, update: if canAccessProjectById(projectId) && isValidProjectFile();
      allow delete: if canAccessProjectById(projectId);
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
