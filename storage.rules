rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isReasonableUpload() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    // PDFs importados, capas, anexos do edital
    match /editais/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isReasonableUpload();
    }

    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isReasonableUpload();
    }
  }
}
