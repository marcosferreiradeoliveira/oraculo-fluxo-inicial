VITE_API_KEY=your_firebase_api_key_here
VITE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_PROJECT_ID=your_project_id
VITE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_app_id
VITE_MEASUREMENT_ID=your_measurement_id
VITE_OPENAI_API_KEY=your_openai_api_key_here
# Só em desenvolvimento (npm run dev): usar emulador de Functions. Em produção é ignorado.
# VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/culturalapp-fb9b0/us-central1
# Em local, o cronograma usa o emulador por padrão. Suba-o com: cd functions && npm run serve
# Para usar a função em produção em dev: VITE_CRONOGRAMA_USE_PROD=1