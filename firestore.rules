rules_version = '2';

// culturalapp-fb9b0 — regras unificadas: Gestor + Finance + Criação
// Mantenha cópias idênticas em dreams-orchestrator, cultura-fluxo-finance e oraculo-fluxo-inicial.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'marcosferreira@mobcontent.com.br'
        && request.auth.token.email_verified == true;
    }

    function isAuth() {
      return isSignedIn();
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.token.email.lower() == 'marcosferreira@mobcontent.com.br'
        && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function docEmailLower() {
      return resource.data.get('email', '').lower();
    }

    function emailsMatch() {
      return request.auth.token.email != null && docEmailLower() == authEmailLower();
    }

    function canReadOwnUsuario(userId) {
      return isSignedIn() && (userId == request.auth.uid || isAdmin());
    }

    function billingFieldNames() {
      return [
        'plan', 'planStatus', 'entitlements', 'creditos', 'credits', 'isPremium', 'planType',
        'stripeSubscriptionId', 'stripeCustomerId', 'lastCreditRefill', 'lastCreditRefillAt',
        'trialCredits', 'role',
        'fornecedorId', 'fornecedorOwnerUid', 'fornecedorNivelAcesso'
      ];
    }

    function hasBillingFields() {
      return request.resource.data.keys().hasAny(billingFieldNames());
    }

    function isBillingFieldChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(billingFieldNames());
    }

    // ─── Finance / Criação: empresas, membros, convites ───────────────────

    function empresaIdFromPath(path) {
      return path.size() >= 2 && path[0] == 'empresas' ? path[1] : '';
    }

    function membroDoc(empresaId) {
      return get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid));
    }

    function isMembroAtivo(empresaId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid))
        && membroDoc(empresaId).data.status == 'active';
    }

    function isOwnerEmpresa(empresaId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/empresas/$(empresaId))
        && get(/databases/$(database)/documents/empresas/$(empresaId)).data.ownerUid == request.auth.uid;
    }

    function assignedProjects(empresaId) {
      return membroDoc(empresaId).data.get('assignedProjects', []);
    }

    function canAccessProject(empresaId, projectId) {
      return isPlatformAdmin()
        || isSuperAdmin()
        || isOwnerEmpresa(empresaId)
        || (isMembroAtivo(empresaId) && (
             membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro']
             || projectId in assignedProjects(empresaId)
           ));
    }

    function projectEmpresaId(projectId) {
      return get(/databases/$(database)/documents/production_projects/$(projectId)).data.empresaId;
    }

    function canAccessProjectById(projectId) {
      return exists(/databases/$(database)/documents/production_projects/$(projectId))
        && projectEmpresaId(projectId) != null
        && canAccessProject(projectEmpresaId(projectId), projectId);
    }

    function canManageEmpresaTeam(empresaId) {
      return isPlatformAdmin()
        || isSuperAdmin()
        || isOwnerEmpresa(empresaId)
        || (isMembroAtivo(empresaId)
            && membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro']);
    }

    function authUsuarioDefaultEmpresaId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('defaultEmpresaId', '');
    }

    function isOwnerUpdatingTeamMember(targetUserId) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && authUsuarioDefaultEmpresaId() != ''
        && isOwnerEmpresa(authUsuarioDefaultEmpresaId())
        && exists(/databases/$(database)/documents/empresas/$(authUsuarioDefaultEmpresaId())/membros/$(targetUserId));
    }

    function isManagerUpdatingTeamMember(targetUserId) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && authUsuarioDefaultEmpresaId() != ''
        && canManageEmpresaTeam(authUsuarioDefaultEmpresaId())
        && exists(/databases/$(database)/documents/empresas/$(authUsuarioDefaultEmpresaId())/membros/$(targetUserId));
    }

    function isOwnMembershipDoc() {
      return isSignedIn()
        && resource != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active';
    }

    function canInviteToEmpresa() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && authUsuarioDefaultEmpresaId() != ''
        && (
          isOwnerEmpresa(authUsuarioDefaultEmpresaId())
          || (isMembroAtivo(authUsuarioDefaultEmpresaId())
              && membroDoc(authUsuarioDefaultEmpresaId()).data.role in ['super_admin', 'gestor_financeiro'])
        );
    }

    function usuarioEmpresaIds() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('empresaIds', []);
    }

    function canSelfBootstrapMembro(empresaId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'status'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          empresaId == '299gnMFuDGcHr1V0Xjq1hRUBw483'
          || empresaId in usuarioEmpresaIds()
        );
    }

    function canViewEmpresaAudit(empresaId) {
      return isMembroAtivo(empresaId)
        && membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro', 'analista_compliance'];
    }

    function loginTouchKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastLoginAt', 'ultimo_login', 'uid', 'updatedAt']);
    }

    function profileEditKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'nome_completo', 'whatsapp', 'empresa', 'equipeBio', 'portfolio', 'dadosCadastrais',
          'dadosCadastraisPessoa', 'dadosCadastraisEmpresa',
          'defaultEmpresaId', 'empresaIds', 'updatedAt',
          'origem', 'data_cadastro', 'createdAt', 'perfil_dados_coletados', 'nomeCompletoInicial',
          'attribution',
          'lastLoginAt', 'ultimo_login', 'email', 'name', 'uid', 'financeiroEmail', 'photoURL',
          'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'utm_id',
          'guiasBaixados', 'portfolioResumoAvaliacao', 'equipeResumoAvaliacao', 'contextoResumoAtualizadoEm'
        ]);
    }

    function projetosCountIncrementOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projetos_criados_count'])
        && request.resource.data.projetos_criados_count == resource.data.get('projetos_criados_count', 0) + 1;
    }

    function empresaLinkKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['empresaIds', 'defaultEmpresaId', 'empresa', 'updatedAt']);
    }

    function usuarioAuthDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function empresaIdLinkedToUser(empresaId) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && empresaId in usuarioAuthDoc().data.get('empresaIds', []);
    }

    function isSuperAdmin() {
      return isPlatformAdmin()
        || (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && usuarioAuthDoc().data.get('role', '') == 'super_admin'
        );
    }

    function canReadEmpresa(empresaId) {
      return isSignedIn() && (
        resource.data.createdByUid == request.auth.uid
        || resource.data.get('ownerUid', '') == request.auth.uid
        || request.auth.uid in resource.data.get('memberUids', [])
        || empresaIdLinkedToUser(empresaId)
      );
    }

    function canManageEmpresa(empresaId) {
      return canReadEmpresa(empresaId);
    }

    function empresaDoc(empresaId) {
      return get(/databases/$(database)/documents/empresas/$(empresaId));
    }

    function canAccessPortfolioEmpresa(empresaId) {
      return empresaIdLinkedToUser(empresaId)
        || (
          exists(/databases/$(database)/documents/empresas/$(empresaId))
          && (
            empresaDoc(empresaId).data.get('createdByUid', '') == request.auth.uid
            || empresaDoc(empresaId).data.get('ownerUid', '') == request.auth.uid
            || request.auth.uid in empresaDoc(empresaId).data.get('memberUids', [])
          )
        );
    }

    function isValidUsuarioCreate(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && !hasBillingFields();
    }

    function gestorFornecedorNivelSyncOnly() {
      return resource.data.get('fornecedorOwnerUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fornecedorNivelAcesso', 'updatedAt'])
        && request.resource.data.fornecedorNivelAcesso in ['limitado', 'operador'];
    }

    function canBillingUsuario(userId) {
      return isSignedIn() && userId == request.auth.uid;
    }

    function usuarioCreditosAtuais() {
      return resource.data.get('creditos', 0);
    }

    function modulo2IaUsageKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['modulo2IaIniciadosAno', 'modulo2IaIniciadosCount', 'updatedAt']);
    }

    match /usuarios/{userId} {
      allow read: if canReadOwnUsuario(userId);

      allow create: if isAdmin()
        || (
          isSignedIn()
          && userId == request.auth.uid
          && !hasBillingFields()
          && (
            isValidUsuarioCreate(userId)
            || (
              request.resource.data.uid == request.auth.uid
              && request.resource.data.email is string
            )
          )
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && userId == request.auth.uid
          && !isBillingFieldChanged()
          && (
            loginTouchKeysOnly()
            || profileEditKeysOnly()
            || empresaLinkKeysOnly()
            || modulo2IaUsageKeysOnly()
            || projetosCountIncrementOnly()
          )
        );

      allow delete: if isAdmin() || isPlatformAdmin();
    }

    function authUsuarioData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function fornecedorIdDoUsuario() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? authUsuarioData().get('fornecedorId', '')
        : '';
    }

    function fornecedorConvidadoNoProjeto() {
      let fid = fornecedorIdDoUsuario();
      return fid != '' && resource.data.get('fornecedorIds', []).hasAny([fid]);
    }

    /** Vínculo via doc `fornecedores` (authUid + dono do projeto) e índice no projeto. */
    function fornecedorAutenticadoDoDonoProjeto() {
      let fid = fornecedorIdDoUsuario();
      return fid != ''
        && exists(/databases/$(database)/documents/fornecedores/$(fid))
        && get(/databases/$(database)/documents/fornecedores/$(fid)).data.get('authUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/fornecedores/$(fid)).data.userId == resource.data.user_id
        && resource.data.get('fornecedorIds', []).hasAny([fid]);
    }

    function fornecedorNivelOperador() {
      return authUsuarioData().get('fornecedorNivelAcesso', 'limitado') == 'operador';
    }

    function fornecedorProjetoUpdateOnly() {
      return fornecedorConvidadoNoProjeto()
        && !fornecedorNivelOperador()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.get('fornecedorIds', []) == resource.data.get('fornecedorIds', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['operacional', 'cronograma', 'data_atualizacao', 'updatedAt']);
    }

    function fornecedorOperadorProjetoUpdate() {
      return fornecedorConvidadoNoProjeto()
        && fornecedorNivelOperador()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.get('fornecedorIds', []) == resource.data.get('fornecedorIds', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'operacional', 'cronograma', 'equipe', 'orcamento',
            'data_atualizacao', 'updatedAt'
          ]);
    }

    match /projetos/{projetoId} {
      allow read: if isSignedIn()
        && (
          isSuperAdmin()
          || resource.data.user_id == request.auth.uid
          || fornecedorConvidadoNoProjeto()
          || fornecedorAutenticadoDoDonoProjeto()
        );
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isSuperAdmin()
          || resource.data.user_id == request.auth.uid
          || fornecedorProjetoUpdateOnly()
          || fornecedorOperadorProjetoUpdate()
        );
      allow delete: if isSignedIn()
        && (isSuperAdmin() || resource.data.user_id == request.auth.uid);
    }

    function fornecedorOwner() {
      return resource.data.userId == request.auth.uid;
    }

    function fornecedorOperadorDoGestor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && authUsuarioData().get('fornecedorNivelAcesso', 'limitado') == 'operador'
        && resource.data.userId == authUsuarioData().get('fornecedorOwnerUid', '');
    }

    function fornecedorLinkedAuth() {
      return resource.data.get('authUid', '') == request.auth.uid;
    }

    function fornecedorConviteEmailMatch() {
      return emailsMatch()
        && (
          resource.data.get('authUid', '') == ''
          || resource.data.get('authUid', '') == request.auth.uid
          || resource.data.get('convitePendente', false) == true
        );
    }

    function fornecedorSupplierLinkKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['authUid', 'convitePendente', 'conviteAt', 'atualizadoEm']);
    }

    match /fornecedores/{fornecedorId} {
      allow read: if isSignedIn()
        && (
          isSuperAdmin()
          || fornecedorOwner()
          || fornecedorLinkedAuth()
          || fornecedorConviteEmailMatch()
          || fornecedorOperadorDoGestor()
        );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isSuperAdmin()
          || fornecedorOwner()
          || (fornecedorConviteEmailMatch() && fornecedorSupplierLinkKeysOnly())
        );
      allow delete: if isSignedIn()
        && (isSuperAdmin() || fornecedorOwner());
    }

    function canReadEmpresaUnified(empresaId) {
      return isPlatformAdmin()
        || isSuperAdmin()
        || canReadEmpresa(empresaId)
        || isMembroAtivo(empresaId)
        || isOwnerEmpresa(empresaId)
        || (isSignedIn() && empresaId == request.auth.uid);
    }

    match /empresas/{empresaId} {
      allow read: if canReadEmpresaUnified(empresaId);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.resource.data.createdByUid == request.auth.uid
          || request.resource.data.ownerUid == request.auth.uid
          || empresaId == request.auth.uid
        )
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0;

      allow update: if canManageEmpresa(empresaId)
        || isOwnerEmpresa(empresaId)
        || isPlatformAdmin();
      allow delete: if isPlatformAdmin()
        || (
          canManageEmpresa(empresaId)
          && (
            resource.data.get('createdByUid', '') == request.auth.uid
            || resource.data.get('ownerUid', '') == request.auth.uid
            || isSuperAdmin()
          )
        );

      match /membros/{membroId} {
        allow read: if isPlatformAdmin()
          || isSuperAdmin()
          || isOwnerEmpresa(empresaId)
          || (isSignedIn() && membroId == request.auth.uid)
          || isMembroAtivo(empresaId)
          || (isSignedIn() && empresaId == request.auth.uid && membroId == request.auth.uid);

        allow create: if isPlatformAdmin()
          || isSuperAdmin()
          || isOwnerEmpresa(empresaId)
          || (isSignedIn()
              && membroId == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'active'
              && (
                empresaId == request.auth.uid
                || (exists(/databases/$(database)/documents/empresas/$(empresaId))
                    && get(/databases/$(database)/documents/empresas/$(empresaId)).data.ownerUid
                      == request.auth.uid)
              ))
          || (isMembroAtivo(empresaId)
              && membroDoc(empresaId).data.role in ['super_admin', 'gestor_financeiro'])
          || (membroId == request.auth.uid && canSelfBootstrapMembro(empresaId));

        allow update: if canManageEmpresaTeam(empresaId)
          || isOwnerEmpresa(empresaId)
          || (isSignedIn()
              && membroId == request.auth.uid
              && empresaId == request.auth.uid);
        allow delete: if isPlatformAdmin() || isOwnerEmpresa(empresaId) || canManageEmpresaTeam(empresaId);
      }

      match /convites/{conviteId} {
        allow read: if canManageEmpresaTeam(empresaId)
          || isOwnerEmpresa(empresaId)
          || (isSignedIn() && resource.data.email.lower() == request.auth.token.email.lower())
          || isPlatformAdmin();
        allow create: if canManageEmpresaTeam(empresaId) || isOwnerEmpresa(empresaId) || isPlatformAdmin();
        allow update: if canManageEmpresaTeam(empresaId)
          || isOwnerEmpresa(empresaId)
          || isPlatformAdmin()
          || (isSignedIn()
              && resource.data.email.lower() == request.auth.token.email.lower()
              && request.resource.data.status == 'accepted');
        allow delete: if canManageEmpresaTeam(empresaId) || isOwnerEmpresa(empresaId) || isPlatformAdmin();
      }

      match /integracoes/{integrationId} {
        allow read, write: if false;
      }

      match /omie_fornecedores/{cnpjId} {
        allow read: if isMembroAtivo(empresaId) || isOwnerEmpresa(empresaId) || isPlatformAdmin() || isSuperAdmin();
        allow write: if false;
      }
    }

    match /{path=**}/convites/{conviteId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn()
            && resource != null
            && request.auth.token.email.lower() == resource.data.email.lower()
            && resource.data.status == 'pending')
        || (isSignedIn()
            && resource != null
            && isOwnerEmpresa(empresaIdFromPath(path)));
    }

    match /{path=**}/membros/{membroId} {
      allow read: if isPlatformAdmin()
        || isSuperAdmin()
        || isOwnMembershipDoc()
        || (isSignedIn() && membroId == request.auth.uid)
        || (isSignedIn()
            && resource != null
            && isOwnerEmpresa(empresaIdFromPath(path)))
        || (isSignedIn()
            && resource != null
            && isMembroAtivo(empresaIdFromPath(path)));
    }

    match /portfolios/{portfolioId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.empresaId != null && canAccessPortfolioEmpresa(resource.data.empresaId))
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.empresaId != null
        && canAccessPortfolioEmpresa(request.resource.data.empresaId);
      allow update, delete: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.empresaId != null && canAccessPortfolioEmpresa(resource.data.empresaId))
      );
    }

    // ─── Finance: production_projects, NF, billing ───────────────────────

    match /production_projects/{projectId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin()
        || isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.empresaId != null && isMembroAtivo(resource.data.empresaId))
        || (resource.data.empresaId != null && canAccessProject(resource.data.empresaId, projectId))
      );

      allow create: if isSignedIn()
        && request.resource.data.empresaId != null
        && (isMembroAtivo(request.resource.data.empresaId)
            || isOwnerEmpresa(request.resource.data.empresaId));

      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || isSuperAdmin()
        || (resource.data.empresaId != null && isOwnerEmpresa(resource.data.empresaId))
        || resource.data.userId == request.auth.uid
        || (resource.data.empresaId != null && canAccessProject(resource.data.empresaId, projectId))
      );

      allow delete: if isSignedIn()
        && resource.data.empresaId != null
        && (
          isPlatformAdmin()
          || isOwnerEmpresa(resource.data.empresaId)
          || isSuperAdmin()
          || (isMembroAtivo(resource.data.empresaId)
              && membroDoc(resource.data.empresaId).data.role == 'super_admin')
        );
    }

    match /omie_anexos/{anexoId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin()
        || isSuperAdmin()
        || (resource.data.projectId != null && canAccessProjectById(resource.data.projectId))
      );
      allow write: if false;
    }

    match /nf_analyses/{analysisId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin()
        || isSuperAdmin()
        || (resource.data.projectId != null && canAccessProjectById(resource.data.projectId))
        || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        isPlatformAdmin()
        || isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.projectId != null
            && exists(/databases/$(database)/documents/production_projects/$(resource.data.projectId))
            && isOwnerEmpresa(
                 get(/databases/$(database)/documents/production_projects/$(resource.data.projectId)).data.empresaId
               ))
        || (resource.data.projectId != null
            && exists(/databases/$(database)/documents/production_projects/$(resource.data.projectId))
            && canManageEmpresaTeam(
                 get(/databases/$(database)/documents/production_projects/$(resource.data.projectId)).data.empresaId
               ))
      );
    }

    match /user_analysis_criteria/{criterionId} {
      allow read: if isSignedIn() && (
        criterionId == 'vxmEHDQer4tNk11XEKeg'
        || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && (!('userId' in request.resource.data)
            || request.resource.data.userId == request.auth.uid);
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow write: if false;
    }

    match /stripe_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /terms_acceptance/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /user_consents/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    match /data_export_logs/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /deleted_accounts/{docId} {
      allow read: if isPlatformAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isPlatformAdmin()
        || canInviteToEmpresa()
        || (resource.data.keys().hasAny(['empresaId'])
            && resource.data.empresaId is string
            && canViewEmpresaAudit(resource.data.empresaId))
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          !('empresaId' in request.resource.data)
          || request.resource.data.empresaId == null
          || isMembroAtivo(request.resource.data.empresaId)
          || isOwnerEmpresa(request.resource.data.empresaId)
          || isPlatformAdmin()
        );
      allow update, delete: if isPlatformAdmin();
    }

    match /locks/{lockId} {
      allow read, write: if false;
    }

    match /expenses/{id} {
      allow read, write: if isSignedIn();
    }

    match /rubrics/{id} {
      allow read, write: if isSignedIn();
    }

    function analysisOwnerUid(data) {
      return data.get('userId', data.get('user_id', data.get('uid', '')));
    }

    function analysisOwnerUnchanged() {
      return analysisOwnerUid(request.resource.data) == analysisOwnerUid(resource.data);
    }

    function projectUserUid(data) {
      return data.get('userId', data.get('uid', ''));
    }

    function isProductionProjectOwner(projectId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/production_projects/$(projectId))
        && get(/databases/$(database)/documents/production_projects/$(projectId)).data.userId
          == request.auth.uid;
    }

    function canAccessProjectUserRecord(data) {
      return isAdmin()
        || projectUserUid(data) == request.auth.uid
        || (data.get('projectId', '') is string
            && data.projectId != ''
            && isProductionProjectOwner(data.projectId));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.get('id', uid) == request.auth.uid
        );
      allow update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);
    }

    match /project_users/{id} {
      allow read: if isSignedIn() && canAccessProjectUserRecord(resource.data);
      allow create: if isSignedIn() && canAccessProjectUserRecord(request.resource.data);
      allow update, delete: if isSignedIn() && canAccessProjectUserRecord(resource.data);
    }

    match /guias/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /analyses/{id} {
      allow read: if isSignedIn()
        && (isAdmin() || analysisOwnerUid(resource.data) == request.auth.uid);
      allow create: if isSignedIn()
        && (isAdmin() || analysisOwnerUid(request.resource.data) == request.auth.uid);
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          analysisOwnerUid(resource.data) == request.auth.uid
          && analysisOwnerUnchanged()
        )
      );
      allow delete: if isSignedIn()
        && (isAdmin() || analysisOwnerUid(resource.data) == request.auth.uid);
    }

    match /podcasts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /podcast_episodios/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /editais/{editalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /remarketing_leads/{docId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() >= 5;
      allow read, update, delete: if isPlatformAdmin();
    }

    match /newsletter_emails/{docId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.keys().hasAll(['email', 'criadoEm']);
      allow read, update, delete: if isPlatformAdmin();
    }
  }
}
