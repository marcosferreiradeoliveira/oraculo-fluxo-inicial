# Copie para functions/.env (deploy) ou functions/.secret.local (emulador).
# Chaves sensíveis: prefira Secret Manager em produção:
#   firebase functions:secrets:set BREVO_API_KEY --project oraculo-is

# Brevo (transactional) — https://app.brevo.com
BREVO_API_KEY=

# Opcional: fallback se Brevo falhar
SENDGRID_API_KEY=

# Remetente: use EXATAMENTE um e-mail "Verificado" em Brevo → Remetentes
# (se enviar com outro From, a Brevo bloqueia ou o Gmail rejeita)
CONVITE_EMAIL_FROM=mobcontent.mda@gmail.com
CONVITE_EMAIL_FROM_NAME=Instituto dos Sonhos

# Ideal depois: domínio próprio (mobcontent.com.br / institutodosonhos) + DKIM/DMARC no Brevo
# e CONVITE_EMAIL_FROM=noreply@seudominio.com.br

PUBLIC_APP_URL=https://criador-is.web.app
